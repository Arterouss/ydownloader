<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_floating_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/floating_widget_body"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_floating_widget"
        android:gravity="center"
        android:elevation="12dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/floating_widget_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_floating_download"
            android:contentDescription="YDownloader Floating Button" />
    </LinearLayout>
</FrameLayout>

